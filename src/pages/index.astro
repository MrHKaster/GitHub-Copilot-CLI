---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const selectedCategoryIds = Astro.url.searchParams
    .getAll('category')
    .map((value) => Number(value))
    .filter((value) => Number.isFinite(value) && value > 0);

const selectedPublisherIds = Astro.url.searchParams
    .getAll('publisher')
    .map((value) => Number(value))
    .filter((value) => Number.isFinite(value) && value > 0);

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase(), {
    categoryIds: selectedCategoryIds,
    publisherIds: selectedPublisherIds,
});
const hasActiveFilters = selectedCategoryIds.length > 0 || selectedPublisherIds.length > 0;
const resultsLabel = hasActiveFilters ? `Showing ${games.length} matching game${games.length === 1 ? '' : 's'}` : `Showing ${games.length} game${games.length === 1 ? '' : 's'}`;
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg">
      <form method="get" class="space-y-5" aria-label="Game filters" data-testid="game-filters-form">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <fieldset class="flex-1" data-testid="category-filter-group">
            <legend class="mb-2 text-sm font-medium uppercase tracking-wide text-slate-300">Categories</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label
                  class="inline-flex items-center gap-2 rounded-full border border-slate-600 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none"
                  data-testid={`category-filter-${category.id}`}
                >
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    checked={selectedCategoryIds.includes(category.id)}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                    aria-label={`Filter by ${category.name}`}
                    data-testid="category-filter-checkbox"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="w-full max-w-xs">
            <label for="publisher-filter" class="mb-2 block text-sm font-medium uppercase tracking-wide text-slate-300">
              Publisher
            </label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              aria-label="Filter by publisher"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id} selected={selectedPublisherIds.includes(publisher.id)}>
                  {publisher.name}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="apply-filters-button"
          >
            Apply filters
          </button>
          {hasActiveFilters && (
            <a
              href="/"
              class="inline-flex items-center justify-center rounded-lg border border-slate-600 bg-slate-900 px-4 py-2 font-medium text-slate-200 transition-colors hover:border-blue-500 hover:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="clear-filters-button"
            >
              Clear filters
            </a>
          )}
        </div>
      </form>
    </div>

    <div class="mb-5 flex items-center justify-between gap-3">
      <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
      <p class="text-sm text-slate-300" aria-live="polite" data-testid="results-summary">{resultsLabel}</p>
    </div>

    <div
      class:list={['grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6', { hidden: games.length === 0 }]}
      data-testid="games-grid"
    >
      {games.map((game) => <GameCard game={game} />)}
    </div>

    <div
      data-testid="empty-state"
      class:list={['text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700', { hidden: games.length > 0 }]}
    >
      <p data-testid="empty-state-text" class="text-slate-300">
        {hasActiveFilters ? 'No games match the selected filters.' : 'No games available at the moment.'}
      </p>
    </div>
  </div>
</Layout>

<script is:inline>
  const updateVisibleGameCards = () => {
    const params = new URLSearchParams(window.location.search);
    const categoryIds = params
      .getAll('category')
      .map((value) => Number(value))
      .filter((value) => Number.isFinite(value) && value > 0);
    const publisherIds = params
      .getAll('publisher')
      .map((value) => Number(value))
      .filter((value) => Number.isFinite(value) && value > 0);

    const grid = document.querySelector('[data-testid="games-grid"]');
    const emptyState = document.querySelector('[data-testid="empty-state"]');
    const summary = document.querySelector('[data-testid="results-summary"]');

    if (!grid) {
      return;
    }

    const cards = Array.from(grid.querySelectorAll('[data-testid="game-card"]'));
    let visibleCount = 0;

    for (const card of cards) {
      const categoryId = Number(card.dataset.categoryId ?? '');
      const publisherId = Number(card.dataset.publisherId ?? '');
      const matchesCategory = categoryIds.length === 0 || categoryIds.includes(categoryId);
      const matchesPublisher = publisherIds.length === 0 || publisherIds.includes(publisherId);
      const isVisible = matchesCategory && matchesPublisher;

      if (isVisible) {
        visibleCount += 1;
        card.hidden = false;
      } else {
        card.remove();
      }
    }

    if (grid) {
      grid.hidden = visibleCount === 0;
    }

    if (emptyState) {
      emptyState.hidden = visibleCount !== 0;
      const text = emptyState.querySelector('[data-testid="empty-state-text"]');
      if (text && (categoryIds.length > 0 || publisherIds.length > 0)) {
        text.textContent = 'No games match the selected filters.';
      }
    }

    if (summary) {
      const hasActiveFilters = categoryIds.length > 0 || publisherIds.length > 0;
      summary.textContent = hasActiveFilters
        ? `Showing ${visibleCount} matching game${visibleCount === 1 ? '' : 's'}`
        : `Showing ${visibleCount} game${visibleCount === 1 ? '' : 's'}`;
    }
  };

  document.addEventListener('DOMContentLoaded', updateVisibleGameCards);
  window.addEventListener('pageshow', updateVisibleGameCards);
  window.addEventListener('popstate', updateVisibleGameCards);
</script>
